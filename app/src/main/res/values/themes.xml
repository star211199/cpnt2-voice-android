<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Oulab" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_blue_dark</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg_main</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.Oulab.Splash" parent="Theme.Oulab">
        <item name="android:windowBackground">@color/bg_main</item>
    </style>

    <!-- AAPT2 隐式父样式：带点号的 style 无显式 parent 时会查找去掉最后一段的名称作为父样式 -->
    <style name="TextAppearance.Oulab" parent="TextAppearance.AppCompat" />

    <style name="TextAppearance.Oulab.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Oulab.Subtitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Oulab.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.Oulab.BigNumber">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Oulab.CardTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_purple</item>
    </style>

    <!-- AAPT2 隐式父样式：Widget.Oulab.Card 无显式 parent，需要 Widget.Oulab 作为父样式 -->
    <style name="Widget.Oulab" parent="Widget.AppCompat.Button" />

    <!-- 通用圆角按钮 -->
    <style name="Widget.Oulab.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">10dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.Oulab.Button.Outlined" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_outlined</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.Oulab.Button.Chip" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_chip</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- 卡片 -->
    <style name="Widget.Oulab.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
