<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CPNT"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            android:background="@drawable/bg_btn_chip_purple"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <!-- 紫色信息卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_purple"
                android:padding="20dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_card_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_on_purple" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_card_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/text_on_purple"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 版本 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_version"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:text="CPNT2 1.1.0"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />

            <!-- 支持的码率 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_supported_modes"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/modesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:text="3200, 2400, 1600, 1400, 1300, 1200, 700C, 450, 450PWB"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace" />

            <!-- 设备信息 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_info"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/deviceInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <!-- 测试 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_run_test"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_run_test_desc"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btnRunTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开始全码率测试"
                android:textColor="@color/text_on_dark"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_primary_selector"
                android:layout_marginTop="12dp" />

            <ScrollView
                android:id="@+id/testResultScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:minHeight="200dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/testResultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="2dp" />
            </ScrollView>

            <!-- 日志诊断 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="日志诊断"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="查看 BLE 连接日志和崩溃报告，可分享给开发者诊断问题"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnViewLog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="查看日志"
                    android:textColor="@color/text_on_dark"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary_selector"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnShareLog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="分享日志"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_chip"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="清除日志"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:background="@drawable/bg_card"
                android:layout_marginTop="8dp" />

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:minHeight="300dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="1dp" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- 底部 Tab 栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/bg_main"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/tabDiscover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tab_discover_gray"
                android:contentDescription="discover" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_discover"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings_blue"
                android:contentDescription="settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_settings"
                android:textSize="12sp"
                android:textColor="@color/primary_blue"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
