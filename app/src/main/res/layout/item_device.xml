<?xml version="1.0" encoding="utf-8"?>
<!-- 单个设备列表项 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- 头像 -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/deviceAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_blue"
            android:gravity="center"
            android:text="V"
            android:textColor="@color/text_on_dark"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 设备信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/deviceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备名称"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_signal_gray"
        android:contentDescription="signal" />

            <TextView
                android:id="@+id/deviceMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="约 5 米 · 可连接"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 操作按钮 -->
    <ImageView
        android:id="@+id/deviceAction"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_call_btn"
        android:src="@drawable/ic_call_green"
        android:scaleType="center"
        android:padding="10dp"
        android:contentDescription="connect" />
</LinearLayout>
