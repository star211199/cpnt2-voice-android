<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- 上半部分(头像/信息卡/选择器)：内容过高时可滚动，不挤压底部按钮 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部对方信息 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="26dp"
                android:paddingBottom="14dp">

                <!-- 头像 + 光环 -->
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <!-- 外圈光环 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_ring" />

                    <TextView
                        android:id="@+id/remoteAvatar"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_purple"
                        android:gravity="center"
                        android:text="C"
                        android:textColor="@color/text_on_dark"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/remoteName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="对方设备"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/callStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="正在连接..."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 紫色编解码信息卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_purple"
                android:layout_marginHorizontal="16dp"
                android:padding="18dp"
                android:gravity="center_horizontal"
                android:elevation="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_thumb_up_purple"
                        android:contentDescription="codec" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_codec_card_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_on_purple"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- 编码/解码 码率 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_encode"
                            android:textSize="13sp"
                            android:textColor="@color/text_on_purple" />

                        <TextView
                            android:id="@+id/encodeBitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_decode"
                            android:textSize="13sp"
                            android:textColor="@color/text_on_purple" />

                        <TextView
                            android:id="@+id/decodeBitrate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/codecMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_codec_meta"
                    android:textSize="12sp"
                    android:textColor="@color/text_on_purple"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- 码率选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_bitrate"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/bitrateChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="12dp"
                app:flexWrap="wrap"
                app:justifyContent="center"
                app:alignItems="center"
                app:alignContent="center" />

            <!-- 音源选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_source"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp" />

            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/sourceChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="12dp"
                app:flexWrap="wrap"
                app:justifyContent="center" />

            <View
                android:layout_width="match_parent"
                android:layout_height="10dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部三按钮：固定钉在底部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="46dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="28dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:id="@+id/btnMute">

            <ImageView
                android:id="@+id/btnMuteIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_btn_selector"
                android:src="@drawable/ic_mic"
                android:scaleType="center"
                android:padding="14dp"
                android:contentDescription="mute" />

            <TextView
                android:id="@+id/btnMuteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_mute"
                android:textSize="12sp"
                android:textColor="@color/call_btn_text_selector"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="28dp"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/btnHangup">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_hangup"
                android:src="@drawable/ic_call_end"
                android:scaleType="center"
                android:padding="20dp"
                android:contentDescription="hangup" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_hangup"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="28dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:id="@+id/btnSpeaker">

            <ImageView
                android:id="@+id/btnSpeakerIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_call_btn_selector"
                android:src="@drawable/ic_speaker"
                android:scaleType="center"
                android:padding="14dp"
                android:contentDescription="speaker" />

            <TextView
                android:id="@+id/btnSpeakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_speaker"
                android:textSize="12sp"
                android:textColor="@color/call_btn_text_selector"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
